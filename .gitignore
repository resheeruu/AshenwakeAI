# ============================================================
# AshenAI .gitignore
# ============================================================

# --- Environment & secrets (NEVER commit) ---
.env
.env.*
!.env.example

# --- Dependencies & build ---
node_modules/
dist/

# --- Data & runtime state ---
data/
*.log

# --- Backup directories & files ---
.agent-backups/
src.backup*/
src.v4-backup/
data.v4-backup/
*.backup
*.backup*
*.bak
*.before-*
*.working
*.working-backup
*.broken
*.corrupted-backup
*.final-backup*

# --- Scratch / agent working dirs ---
.agent/
.aistart/
.claudin/
.coding-agent-test/
.game-backup/
.ashenai/
.openclaude/
.npm/

# --- PID & state files ---
*.pid
.ashennai-mode
.ashennai-anomaly

# --- Legacy root-level scripts (superseded by scripts/) ---
check-commands.ts
cleanup-commands.ts
clear-guild-commands.ts

# --- Specific stray artifacts ---
🔎
Thats*

# --- Legacy working file ---
src/index.working.ts
