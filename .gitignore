# ============================================================
# AshenAI .gitignore
# ============================================================

# --- Environment & secrets (NEVER commit) ---
.env
.env.*
!.env.example

# --- Dependencies (NEVER commit) ---
node_modules/
dist/
*.tsbuildinfo

# --- Data & runtime state ---
data/
*.log
.ashenai-dep-hash

# --- Backup directories & files ---
.agent-backups/
src.backup*/
src.v4-backup/
data.v4-backup/
*.backup
*.backup*
*.bak
*.before-*
*.working
*.working-backup
*.broken
*.corrupted-backup
*.final-backup*

data/.test-rollback-repo/

# --- Scratch / agent working dirs ---
.agent/
.aistart/
.claudin/
.coding-agent-test/
.game-backup/
.ashenai/
.openclaude/
.npm/

# --- PID & state files ---
*.pid
.ashennai-mode
.ashennai-anomaly
.enospc-flag

# --- Legacy root-level scripts (superseded by scripts/) ---
check-commands.ts
cleanup-commands.ts
clear-guild-commands.ts

# --- Specific stray artifacts ---
🔎
Thats*

# --- Emoji manifest (guild-specific IDs, generated by upload script) ---
assets/emojis/emoji-manifest.json

# --- Generated audit/snapshot reports ---
scripts/docs/

# --- Legacy working file ---
src/index.working.ts

.gemini/
gha-creds-*.json
