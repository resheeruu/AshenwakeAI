{
  "name": "ashenai",
  "version": "1.0.0",
  "description": "AshenAI Discord AI assistant",
  "main": "index.js",
  "bin": {
    "ashen": "dist/cli.js"
  },
  "scripts": {
    "start": "bash scripts/start.sh",
    "agent": "tsx src/agent/index.ts",
    "cli": "tsx src/cli.ts",
    "test": "tsx scripts/test-router.ts && tsx scripts/test-core.ts && tsx scripts/test-commands.ts && tsx scripts/test-rate-limit.ts && tsx scripts/test-security.ts && tsx scripts/test-tasks.ts && tsx scripts/test-settlement.ts",
    "check": "tsx scripts/check.ts && npm test",
    "typecheck": "tsc --noEmit",
    "build": "tsc && rm -rf dist/web/public && cp -r src/web/public dist/web/public",
    "bot": "tsx src/index.ts",
    "agents": "tsx scripts/check-coding-agents.ts",
    "test-agents": "tsx scripts/test-coding-agents.ts",
    "auth:owner-recover": "tsx scripts/owner-recover.ts",
    "deploy:advisor": "tsx scripts/deployment-advisor.ts"
  },
  "keywords": [
    "discord",
    "ai",
    "bot"
  ],
  "type": "commonjs",
  "dependencies": {
    "chokidar": "^5.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
