{
  "name": "ashenai",
  "version": "1.0.0",
  "description": "AshenAI Discord AI assistant",
  "main": "index.js",
  "scripts": {
    "start": "bash scripts/render-start.sh",
    "agent": "tsx src/agent/index.ts",
    "test": "tsx scripts/test-router.ts && tsx scripts/test-core.ts && tsx scripts/test-commands.ts && tsx scripts/test-rate-limit.ts && tsx scripts/test-security.ts && tsx scripts/test-tasks.ts && tsx scripts/test-settlement.ts",
    "check": "tsx scripts/check.ts && npm test",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "bot": "tsx src/index.ts",
    "agents": "tsx scripts/check-coding-agents.ts",
    "test-agents": "tsx scripts/test-coding-agents.ts"
  },
  "keywords": [
    "discord",
    "ai",
    "bot"
  ],
  "type": "commonjs",
  "dependencies": {
    "@discord-player/extractor": "^4.5.1",
    "@discordjs/voice": "^0.19.2",
    "chokidar": "^5.0.0",
    "discord-player": "^6.6.6",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "opusscript": "^0.0.8",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  }
}
