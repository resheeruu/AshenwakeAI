# ============================================================
# AshenAI Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Discord Bot (REQUIRED) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# --- Lavalink (Music) (REQUIRED) ---
LAVALINK_URL=
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
LAVALINK_NAME=main

# --- Owner Authentication (REQUIRED) ---
ASHENAI_OWNER_USERNAME=
ASHENAI_OWNER_PASSWORD_HASH=
ASHENAI_OWNER_PASSWORD_SALT=

# --- Creator Identity ---
CREATOR_NAME=Xykel
CREATOR_DISCORD=

# --- Admin Discord User IDs (comma-separated) ---
ADMIN_DISCORD_USER_IDS=

# --- Web Server ---
# Optional: port for web dashboard
# PORT=3000
# WEB_PORT=3000

# --- OAuth (Optional) ---
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# --- Discord OAuth2 (Optional, for web dashboard login) ---
# If not set, falls back to DISCORD_CLIENT_ID/SECRET/REDIRECT_URI
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=

# --- Google OAuth2 (Optional, for web dashboard login) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Auth Base URL (Required for password reset emails and OAuth redirects) ---
# Set to your public URL e.g. https://ashenwakeai.onrender.com
AUTH_BASE_URL=

# --- Session (Optional, but recommended) ---
# Generate a long random hex string for production
SESSION_SECRET=

# --- SMTP (Optional, for password reset emails) ---
# If not set, emails are logged to console in dev mode
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Dev Mode ---
# Set to true to log reset links to console (development only)
AUTH_DEV_RESET_LINKS=false

# --- CORS Origins (Optional, comma-separated) ---
# ASHENAI_CORS_ORIGINS=http://localhost:3000

# --- AI Provider Keys (all optional - enable what you use) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NOVITA_API_KEY=

# --- AI Provider Models (optional, have defaults) ---
GEMINI_MODEL=
CEREBRAS_MODEL=
SAMBANOVA_MODEL=
GROQ_MODEL=

# --- AI Configuration (optional) ---
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=3
AI_MAX_CONTEXT_MESSAGES=20
AI_MEMORY_IDLE_MINUTES=30

# --- Logging (optional) ---
# LOG_LEVEL=info
# ASHENAI_VERBOSE_LOGS=false

# --- Ollama (Optional) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
