# ============================================================
# AshenAI Environment Configuration
# ============================================================
# Run "npm run setup" to auto-generate secrets and create
# this file automatically. Then edit with your credentials.
#
# NEVER commit .env to version control.
# ============================================================

# --- Discord Bot (REQUIRED) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# --- Owner Authentication ---
# Auto-generated by "npm run setup" if missing.
# ASHENAI_OWNER_USERNAME=
# ASHENAI_OWNER_PASSWORD_HASH=
# ASHENAI_OWNER_PASSWORD_SALT=

# --- Session Security ---
# Auto-generated by "npm run setup" if missing.
# SESSION_SECRET=

# --- Creator Identity (optional) ---
CREATOR_NAME=Xykel
CREATOR_DISCORD=

# --- Admin Discord User IDs (optional, comma-separated) ---
ADMIN_DISCORD_IDS=

# --- Web Server ---
# PORT is set by your hosting environment (e.g., Wispbyte, Render).
# TRUST_PROXY sets the Express "trust proxy" setting.
# Default: 1 (one proxy). Increase for multiple reverse proxies.
# Set to 0 for direct connections (no proxy).
# TRUST_PROXY=1

# --- OAuth (optional) ---
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
AUTH_BASE_URL=

# --- Credential Encryption (optional) ---
# ASHENAI_CREDENTIAL_KEY=

# --- SMTP (optional, for password reset emails) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Dev Mode (optional) ---
AUTH_DEV_RESET_LINKS=false

# --- CORS Origins (optional, comma-separated) ---
# ASHENAI_CORS_ORIGINS=http://localhost:3000

# --- AI Provider Keys (all optional — enable what you use) ---
# Custom emojis are auto-provisioned. No manual emoji config needed.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NOVITA_API_KEY=

# --- AI Configuration (optional, have defaults) ---
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2
# AI_MAX_CONTEXT_MESSAGES=20
# AI_MEMORY_IDLE_MINUTES=30

# --- Logging (optional) ---
# LOG_LEVEL=info
# ASHENAI_VERBOSE_LOGS=false

# --- Resource Thresholds (optional, operational) ---
# NOTE: these guard the container-visible minimum only. They are NOT the
# hosting account/server quota, which cannot be verified from inside the
# container. Actual Wispbyte storage quota could not be verified from
# inside the container. ENOSPC can still occur below/above these when
# quota, overlay upperdir, /tmp tmpfs, inodes, or per-container limits bind.
# Disk: warn/critical thresholds
# ASHENAI_RESOURCE_DISK_WARN_MB=100
# ASHENAI_RESOURCE_DISK_CRITICAL_MB=50
# ASHENAI_RESOURCE_DISK_WARN_PERCENT=20
# ASHENAI_RESOURCE_DISK_CRITICAL_PERCENT=5
# RAM: warn/critical thresholds (percent used)
# ASHENAI_RESOURCE_RAM_WARN_PERCENT=80
# ASHENAI_RESOURCE_RAM_CRITICAL_PERCENT=90
# CPU: load average warning threshold
# ASHENAI_RESOURCE_CPU_WARN_LOAD=4

# --- Ollama (optional, auto-detected if running) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
