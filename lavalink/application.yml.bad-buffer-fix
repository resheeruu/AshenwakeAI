server:
  port: 2333
  address: 0.0.0.0

plugins:
  youtube:
    enabled: true
    allowSearch: true
    allowDirectVideoIds: true
    allowDirectPlaylistIds: true

    oauth:
      enabled: true
      refreshToken: ""

    clients:
      - TV
      - WEB
      - WEBEMBEDDED
      - ANDROID_MUSIC
      - MUSIC
      - ANDROID_VR
      - IOS
      - TVHTML5_SIMPLY
lavalink:
  server:
    password: "ashenai-local"
  plugins:
    - dependency: "dev.lavalink.youtube:youtube-plugin:1.18.2"
      snapshot: false

sources:
  youtube: false
  bandcamp: true
  soundcloud: true
  twitch: true
  vimeo: true
  http: true
  local: false

filters:
  volume: true
  equalizer: true
  karaoke: true
  timescale: true
  tremolo: true
  vibrato: true
  distortion: true
  rotation: true
  channelMix: true
  lowPass: true

logging:
  level:
    root: INFO
    lavalink: INFO

  bufferDurationMs: 0
